{
    "name": "vscode-usda-syntax",
    "displayName": "USD Language",
    "description": "Pixar USD Language Extension by Animal Logic",
    "version": "0.2.0",
    "author": {
        "name": "Aloys Baillet",
        "email": "aloys.baillet@al.com.au",
        "url": "https://www.animallogic.com"
    },
    "publisher": "animallogic",
    "keywords": [
        "animallogic",
        "AL_USDMaya",
        "pixar",
        "usd",
        "usda"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/AnimalLogic/AL_usd_vscode_extension"
    },
    "icon": "images/animallogic_logo.jpg",
    "engines": {
        "vscode": "^1.49.0"
    },
    "main": "src/extension.js",
    "activationEvents": [
        "onLanguage:usd",
        "onCommand:usd.openAsUsda",
        "onCustomEditor:usd.usdcViewer"
    ],
    "devDependencies": {
        "@types/node": "^8.10.51",
        "@types/vscode": "^1.49.0",
        "vscode-uri": "^2.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "usd",
                "aliases": [
                    "USD",
                    "usd"
                ],
                "extensions": [
                    ".usd",
                    ".usda",
                    ".usdc",
                    ".usda.in"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "usd",
                "scopeName": "source.usd",
                "path": "./syntaxes/usd.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "usd.openAsUsda",
                "title": "USD: Open as USDA"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "usd.openAsUsda",
                    "when": "resourceExtname == .usdc || resourceExtname == .usd",
                    "group": "navigation"
                }
            ],
            "editor/title/context": [
                {
                    "command": "usd.openAsUsda",
                    "when": "resourceExtname == .usdc || resourceExtname == .usd"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "usd.usdcViewer",
                "displayName": "USDC (as USDA)",
                "selector": [
                    {
                        "filenamePattern": "*.usdc"
                    }
                ],
                "priority": "default"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "USD",
            "properties": {
                "usd.resolve": {
                    "type": "string",
                    "default": "usdresolve --anchorPath \"{anchorPath}\" \"{inputPath}\"",
                    "description": "UsdResolve command template used to resolve asset paths inside usd files."
                },
                "usd.cat": {
                    "type": "string",
                    "default": "usdcat --usdFormat usda \"{inputPath}\"",
                    "description": "UsdCat command template used to convert .usdc files to a .usda preview."
                }
            }
        }
    },
    "license": "SEE LICENSE IN LICENSE"
}
